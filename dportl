#!/bin/bash

# modified from the script here: https://www.wireguard.com/netns/
# using info from here: https://volatilesystems.org/wireguard-in-a-separate-linux-network-namespace.html

# This version is for running wireguard inside a Docker container.

# Make sure we're running as root (auto-elevates if you have NOPASSWD sudo configured)
[[ $UID != 0 ]] && exec sudo -E "$(readlink -f "$0")" "$@"

NAMESPACE="dportl"
INTERFACE="dportl0"
CONF="/etc/wireguard/${NAMESPACE}.conf"

# Some functions may need to recursively call this script
portlCMD=$0

Red='\033[1;31m'
Off='\033[0m'

config() {
    # -e causes the script to exit if any command errors out
    # -x prints each executed line, prepended with a +
    set -e
    supported="address|dns|mtu"
    unsupported="table|preup|postup|predown|postdown|saveconfig"
    
    #warn if unsupported options are found
    while read -r u; do
        echo -e "${Red}Ignoring unsupported config option: ${u} ${Off}"
    done < <(grep -i -E "^[[:space:]]*(${unsupported})" "$1")
    
    
    # Comment out Address and DNS lines because the wg command doesn't support them (only wg-quick does)
    # Need Address and DNS to still be present so they can be parsed as part of the up() function
    # For those lines, also add a ~ to mark that those lines weren't commented out in the original and should be used
    # Without some marker like this we might parse pre-commented lines were supposed to be ignored
    # Double-comment other unsupported lines we don't need (could just delete them)
    # Write to configuration file (overwriting)
    sed -E "s/^[[:space:]]*(${supported})/#~\1/Ig" "$1" \
        | sed -E "s/^[[:space:]]*(${unsupported})/##\1/Ig" \
        > "${CONF}"
    
    echo "Config file parsed and written to ${CONF}"
}

up() {
    set -e

    # If a second argument was provided, treat it as the config file to use
    if [ -n "$2" ]; then
        config "$2"
    fi

    set -x

    # Link the container's network namespace file to where 'ip netns' can use it.
    pid=$(docker inspect -f '{{.State.Pid}}' "$1")
    if [[ ! $pid || $pid == 0 ]]; then
        echo "Invalid PID for Container ID $1, ensure the ID is a valid running container"
        exit 2
    fi
    rm -f /var/run/netns/"$NAMESPACE"
    ln -s /proc/$pid/ns/net /var/run/netns/"$NAMESPACE"
    
    #ip netns add "$NAMESPACE"
    ip link add "$INTERFACE" type wireguard
    ip link set "$INTERFACE" netns "$NAMESPACE"
    ip netns exec "$NAMESPACE" wg setconf "$INTERFACE" "$CONF"
    
    #Parse addresses
    while read -r address; do
        ip -n "$NAMESPACE" addr add "$address" dev "$INTERFACE"
    done < <(grep -i "^#~address" "$CONF" | cut -d= -f2 | tr -d " " | tr "," "\n")
    
    #Parse MTU
    while read -r mtu; do
        if ! [ -z "$mtu" ]; then
            ip -n "$NAMESPACE" link set dev "$INTERFACE" mtu "$mtu"
        fi
    done < <(grep -i "^#~mtu" "$CONF" | cut -d= -f2 | tr -d " ")
    
    #Parse DNS
    #By default, /etc/resolve.conf will be used by the namespace
    #If /etc/netns/NAMESPACE_NAME/resolv.conf exists (it is persistent), that will be used by the namespace instead
    #If the config file specifies DNS, this will parse it, truncate /etc/netns/"$NAMESPACE"/resolv.conf, and apply the settings; otherwise no changes to the filesystem will be made
    dns_setup=0
    while read -r dns; do
        if [[ "$dns_setup" == 0 ]]; then
            mkdir -p /etc/netns/"$NAMESPACE" #make dir structure if it doesn't exist
            > /etc/netns/"$NAMESPACE"/resolv.conf #create or truncate the file
            chmod o+r /etc/netns/"$NAMESPACE"/resolv.conf #make sure it's world-readable
            dns_setup=1 #don't truncate the file on subsequent loops
        fi
        echo nameserver "$dns" >> /etc/netns/"$NAMESPACE"/resolv.conf
    done < <(grep -i "^#~dns" "$CONF" | cut -d= -f2 | tr -d " " | tr "," "\n")
    
    # Remove all existing interfaces (other than lo)
    while read -r iface; do
        if [[ "$iface" != "lo" ]]; then
            ip netns exec "$NAMESPACE" ip link delete "$iface"
        fi
    done < <(ip netns exec "$NAMESPACE" netstat -i | tail -n +3 | cut -d " " -f 1) #ignore the first two header lines
    
    
    ip -n "$NAMESPACE" link set "$INTERFACE" up
    ip -n "$NAMESPACE" link set lo up
    ip -n "$NAMESPACE" route add default dev "$INTERFACE"

    set +x
    echo "Namespace Up!"
}

down() {
    set -x
    ip -n "$NAMESPACE" link set "$INTERFACE" down
    ip -n "$NAMESPACE" link del "$INTERFACE"
    #ip link del "$INTERFACE" #in case the config file had an issue and the interface was created but not moved
    ip netns del "$NAMESPACE"
    rm -f /var/run/netns/"$NAMESPACE"
    rm -f /etc/netns/"$NAMESPACE"/resolv.conf

    set +x
    echo "Namespace Removed!"
}

exec_n() {
    #exec completely replaces this script process with the specified process
    exec ip netns exec "$NAMESPACE" sudo -E -u \#${SUDO_UID:-$(id -u)} -g \#${SUDO_GID:-$(id -g)} "$@"
    exit #this is never reached, just here to remind you that there's no returning from this function
}

show() {
    ip netns exec "$NAMESPACE" wg show
}

forward_usage() {
    echo "Usage: $portlCMD fwd protocol fromPort [toPort]"
    echo "       $portlCMD fwd show"
    echo "protocol must be tcp, t, udp, or u"
    echo "toPort will be same as fromPort if not specified"
}

forward_runtime_dir() {
    printf '/run/portl/%s/forwards\n' "$NAMESPACE"
}

forward_list() {
    local runtime_dir state_file socket_file state_basename lock_file state_lock_fd
    local pid protocol from_port to_port backend started_at key value
    local active=0 stale=0

    runtime_dir=$(forward_runtime_dir)
    if [[ ! -d "$runtime_dir" ]]; then
        echo "No active forwards for namespace $NAMESPACE."
        return 0
    fi

    shopt -s nullglob
    for state_file in "$runtime_dir"/*.state; do
        pid= protocol= from_port= to_port= backend= started_at=
        while IFS='=' read -r key value; do
            case "$key" in
                pid) pid=$value ;;
                protocol) protocol=$value ;;
                from_port) from_port=$value ;;
                to_port) to_port=$value ;;
                backend) backend=$value ;;
                started_at) started_at=$value ;;
            esac
        done < "$state_file"

        lock_file=${state_file%.state}.lock
        exec {state_lock_fd}>"$lock_file" || return 1
        if flock -n "$state_lock_fd"; then
            state_basename=${state_file##*/}
            if [[ "$protocol" =~ ^(tcp|udp)$ ]] && valid_port "$from_port" && valid_port "$to_port" \
                && [[ "$state_basename" == "$protocol-$from_port.state" ]]; then
                socket_file="$runtime_dir/$protocol-$from_port-$to_port.sock"
                rm -f -- "$socket_file"
            fi
            rm -f -- "$state_file"
            exec {state_lock_fd}>&-
            stale=$((stale + 1))
            continue
        fi
        exec {state_lock_fd}>&-

        if [[ $active -eq 0 ]]; then
            printf '%-8s %-6s %-6s %-8s %-8s %s\n' "PROTOCOL" "FROM" "TO" "BACKEND" "PID" "STARTED"
        fi
        printf '%-8s %-6s %-6s %-8s %-8s %s\n' \
            "$protocol" "$from_port" "$to_port" "$backend" "$pid" "$started_at"
        active=$((active + 1))
    done
    shopt -u nullglob

    if [[ $active -eq 0 ]]; then
        echo "No active forwards for namespace $NAMESPACE."
    fi
    if [[ $stale -gt 0 ]]; then
        echo "Removed $stale stale forward record(s)." >&2
    fi
}

socat_supports_netns() {
    # Exercise the option without opening a network port.
    socat --experimental -u \
        "OPEN:/dev/null,rdonly,netns=$NAMESPACE" \
        "OPEN:/dev/null,wronly" >/dev/null 2>&1
}

select_forward_backend() {
    local requested=${PORTL_FWD_MODE:-auto}

    case "${requested,,}" in
        auto)
            if socat_supports_netns; then
                printf 'netns\n'
            else
                printf 'socket\n'
            fi
            ;;
        netns)
            if ! socat_supports_netns; then
                echo "Error: PORTL_FWD_MODE=netns was requested, but socat netns support is unavailable." >&2
                return 1
            fi
            printf 'netns\n'
            ;;
        socket)
            printf 'socket\n'
            ;;
        *)
            echo "Error: PORTL_FWD_MODE must be auto, netns, or socket." >&2
            return 1
            ;;
    esac
}

valid_port() {
    [[ "$1" =~ ^[0-9]+$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535))
}

forward() {
    # Forward a port from inside NAMESPACE to localhost in the namespace from
    # which this script was invoked. Modern socat can create the listener in a
    # named namespace directly; older builds use a Unix socket compatibility
    # bridge under /run.
    local protocol pl nsPort extPort backend runtime_dir socket_file state_file state_tmp lock_file
    local started_at wait_status=0
    local forward_lock_fd pid dependency
    local -a relay_pids=()

    command -v flock >/dev/null 2>&1 || {
        echo "Error: flock is required for port forwarding." >&2
        return 1
    }

    if [[ "${1,,}" == "show" ]]; then
        if [[ $# -ne 1 ]]; then
            forward_usage >&2
            return 1
        fi
        forward_list
        return
    fi

    if [[ $# -lt 2 || $# -gt 3 ]]; then
        forward_usage >&2
        return 1
    fi

    protocol=${1,,}
    nsPort=$2
    extPort=${3:-$nsPort}
    case "$protocol" in
        tcp|t) pl=tcp ;;
        udp|u) pl=udp ;;
        *)
            echo "Error: protocol must be tcp, t, udp, or u." >&2
            forward_usage >&2
            return 1
            ;;
    esac
    if ! valid_port "$nsPort" || ! valid_port "$extPort"; then
        echo "Error: ports must be integers from 1 through 65535." >&2
        return 1
    fi
    for dependency in socat setsid; do
        command -v "$dependency" >/dev/null 2>&1 || {
            echo "Error: $dependency is required for port forwarding." >&2
            return 1
        }
    done
    backend=$(select_forward_backend) || return 1
    runtime_dir=$(forward_runtime_dir)
    mkdir -p "$runtime_dir" || return 1

    socket_file="$runtime_dir/$pl-$nsPort-$extPort.sock"
    state_file="$runtime_dir/$pl-$nsPort.state"
    state_tmp="$state_file.$$"
    lock_file="$runtime_dir/$pl-$nsPort.lock"

    exec {forward_lock_fd}>"$lock_file" || return 1
    if ! flock -n "$forward_lock_fd"; then
        echo "Error: a managed $pl forward is already using port $nsPort in namespace $NAMESPACE." >&2
        exec {forward_lock_fd}>&-
        return 1
    fi
    rm -f -- "$socket_file" "$state_tmp"

    forward_start_relay() {
        setsid "$@" {forward_lock_fd}>&- &
        pid=$!
        relay_pids+=("$pid")
    }

    forward_cleanup() {
        local signal=${1:-TERM} child

        # Socat's fork workers inherit their parent's process group. Signaling
        # the group removes workers as well as the directly managed process.
        for child in "${relay_pids[@]}"; do
            kill -s "$signal" -- "-$child" 2>/dev/null || true
        done
        for child in "${relay_pids[@]}"; do
            wait "$child" 2>/dev/null || true
        done
        rm -f -- "$socket_file" "$state_file" "$state_tmp"
        exec {forward_lock_fd}>&-
    }

    forward_handle_signal() {
        local signal=$1 status=$2
        trap - INT QUIT HUP TERM EXIT
        forward_cleanup "$signal"
        exit "$status"
    }

    trap 'forward_handle_signal INT 130' INT
    trap 'forward_handle_signal QUIT 131' QUIT
    trap 'forward_handle_signal HUP 129' HUP
    trap 'forward_handle_signal TERM 143' TERM
    trap 'forward_cleanup TERM' EXIT

    echo "Forward backend: $backend"
    if [[ "$backend" == "netns" ]]; then
        if [[ "$pl" == "tcp" ]]; then
            forward_start_relay socat --experimental \
                "TCP6-LISTEN:$nsPort,reuseaddr,fork,netns=$NAMESPACE" \
                "TCP:localhost:$extPort" || return 1
        else
            forward_start_relay socat --experimental -b 65535 \
                "UDP6-LISTEN:$nsPort,reuseaddr,fork,netns=$NAMESPACE" \
                "UDP:localhost:$extPort" || return 1
        fi
    else
        if [[ "$pl" == "tcp" ]]; then
            forward_start_relay socat \
                "UNIX-LISTEN:$socket_file,reuseaddr,fork" \
                "TCP:localhost:$extPort" || return 1
            forward_start_relay ip netns exec "$NAMESPACE" socat \
                "TCP6-LISTEN:$nsPort,reuseaddr,fork" \
                "UNIX-CONNECT:$socket_file" || return 1
        else
            # SOCK_SEQPACKET (type=5) preserves UDP datagram boundaries.
            forward_start_relay socat -b 65535 \
                "UNIX-LISTEN:$socket_file,type=5,reuseaddr,fork" \
                "UDP:localhost:$extPort" || return 1
            forward_start_relay ip netns exec "$NAMESPACE" socat -b 65535 \
                "UDP6-LISTEN:$nsPort,reuseaddr,fork" \
                "UNIX-CONNECT:$socket_file,type=5" || return 1
        fi
    fi

    started_at=$(date '+%Y-%m-%d %H:%M:%S')
    {
        echo "pid=$$"
        echo "protocol=$pl"
        echo "from_port=$nsPort"
        echo "to_port=$extPort"
        echo "backend=$backend"
        echo "started_at=$started_at"
    } > "$state_tmp" || return 1
    mv -f -- "$state_tmp" "$state_file" || return 1

    echo "$pl: $nsPort -> $extPort"
    wait -n "${relay_pids[@]}" || wait_status=$?

    trap - INT QUIT HUP TERM EXIT
    forward_cleanup TERM
    return "$wait_status"
}

usage() {
    echo "Usage: $(basename "$0") [ config FILE | up CONTAINER_ID [FILE] | down | show | exec CMD | run CMD | fwd OPTIONS | help ]"
    echo ""
    echo "COMMANDS"
    echo -e "\tconfig FILE"
    echo -e "\t\tSet FILE as the wireguard configuration file to use when creating or deleting the dportl namespace\n"

    echo -e "\tup CONTAINER_ID [FILE]"
    echo -e "\t\tCreate the dportl namespace and symlink it to the docker container namespace used by CONTAINER_ID (the truncated 12-character ID, as shown in 'docker ps'). This deletes all network interfaces inside the container (except 'lo') and replaces them with a dportl interface, forcing all the container's networking to go through it. Must either run 'config' first or specify a config file\n"

    echo -e "\tdown"
    echo -e "\t\tDeletes the configured dportl namespace. The target docker container namespace continues to exist, but the dportl interface inside it will be deleted.\n"

    echo -e "\tshow"
    echo -e "\t\tShortcut to run 'wg show' within the dportl namespace\n"

    echo -e "\texec CMD..."
    echo -e "\t\tRun any command within the dportl namespace. However, the purpose of this script is really to make any commands run inside the docker container go through the wireguard tunnel, so you shouldn't need to use this.\n"

    echo -e "\trun CMD..."
    echo -e "\t\tAlias for exec\n"

    echo -e "\tfwd PROTOCOL fromPort [toPort]"
    echo -e "\t\tForward localhost port traffic from inside the dportl namespace to a localhost port in the host namespace\n"
    echo -e "\t\tPROTOCOL must be tcp, t, udp, or u\n"
    echo -e "\t\ttoPort will be the same as fromPort if not specified\n"

    echo -e "\tfwd show"
    echo -e "\t\tList active forwards and the backend selected for each one\n"

    echo -e "\thelp"
    echo -e "\t\tDisplay this help message\n"
    echo ""
    echo -e "Each command can also be run by specifying only its first letter, such as 's' instead of 'show'.\n"
    echo ""
    
    echo "Example"
    echo "-------"
    echo "dportl up e90b8831a4b8 ./tunnel.conf"
    echo "docker exec -it e90b8831a4b8 ping -c 4 10.0.0.1"
    echo "docker exec -it e90b8831a4b8 curl 10.0.0.1:8080/info.txt"
    echo "dportl down"
    echo "docker stop e90b8831a4b8"
    
}

if [[ $UID != 0 ]]; then
    echo -e "${Red}Must run as root!${Off}"
    usage
    exit 1
fi

command="$1"

case "$command" in
    config) shift && config "$@" ;;
    configure) shift && config "$@" ;;
    c) shift && config "$@" ;; #shortcut
    
    up) shift && up "$@" ;;
    u) shift && up "$@" ;; #shortcut
    
    down) down ;;
    d) down ;; #shortcut
    
    show) show ;;
    s) show ;; #shortcut
    
    exec) shift && exec_n "$@" ;;
    e) shift && exec_n "$@" ;; #shortcut
    run) shift && exec_n "$@" ;; #same as exec
    r) shift && exec_n "$@" ;; #shortcut

    fwd) shift && forward "$@" ;;
    f) shift && forward "$@" ;;

    help) usage ; exit 1 ;;
    h) usage ; exit 1 ;;
    --help) usage ; exit 1 ;;
    -h) usage ; exit 1 ;;
    
    *) exec_n "$@" ;; #asume exec
esac
